# Web (Next.js)
# Use 127.0.0.1 (not localhost) so Windows browsers don't hit IPv6 ::1 while the API is IPv4-only.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Set to 0 to disable WS /ws/scene/{id} (on by default; presence + patch + locks)
# NEXT_PUBLIC_SCENE_WS=0
# Optional Supabase client (Phase 5) — leave blank for WS fallback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API (FastAPI)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SCENE_STORE=memory
# Optional: when SCENE_STORE=supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=
# Soft-lock TTL in seconds (default 30)
LOCK_TTL_SECONDS=30
# Optional hybrid AI (Phase 3) — rules always; Grok LLM when XAI_API_KEY is set
# Default model: grok-4.6 via https://api.x.ai/v1 (OpenAI-compatible SDK)
XAI_API_KEY=xai-...
# Deprecated alias — still works if XAI_API_KEY is unset
# OPENAI_API_KEY=
# Optional Stripe test-mode checkout (Phase 4); sandbox stub URL if unset
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=http://localhost:3000/?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/?checkout=cancel

# iOS (separate process) — see apps/ios/README.md for Xcode + APIConfig.swift
# Device LAN: run API with --host 0.0.0.0; set SHARED_SPATIAL_API_URL or edit APIConfig.swift
